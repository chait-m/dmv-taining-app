@using DmvTrainingApp.Models

<div>
    <h3>Step 1: Vehicle Information</h3>
    <div class="mb-3">
        <label>VIN:</label>
        <InputText class=@($"form-control w-50 {GetInputClass(nameof(Model.VIN))}") @bind-Value="Model.VIN" />
        <ValidationMessage For="() => Model.VIN" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Make:</label>
        <InputText class=@($"form-control w-50 {GetInputClass(nameof(Model.Make))}") @bind-Value="Model.Make" />
        <ValidationMessage For="() => Model.Make" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Model:</label>
        <InputText class=@($"form-control w-50 {GetInputClass(nameof(Model.Model))}") @bind-Value="Model.Model" />
        <ValidationMessage For="() => Model.Model" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Year:</label>
        <InputNumber class=@($"form-control w-50 {GetInputClass(nameof(Model.Year))}") @bind-Value="Model.Year" />
        <ValidationMessage For="() => Model.Year" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Color:</label>
        <InputText class=@($"form-control w-50 {GetInputClass(nameof(Model.Color))}") @bind-Value="Model.Color" />
        <ValidationMessage For="() => Model.Color" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Body Type:</label>
        <InputText class=@($"form-control w-50 {GetInputClass(nameof(Model.BodyType))}") @bind-Value="Model.BodyType" />
        <ValidationMessage For="() => Model.BodyType" class="invalid-feedback d-block" />
    </div>
    <div class="mb-3">
        <label>Odometer Reading:</label>
        <InputNumber class=@($"form-control w-50 {GetInputClass(nameof(Model.OdometerReading))}") @bind-Value="Model.OdometerReading" />
        <ValidationMessage For="() => Model.OdometerReading" class="invalid-feedback d-block" />
    </div>
    <button class="btn btn-primary" type="button" @onclick="NextStep">Next</button>
</div>

@code {
    [Parameter] public VehicleTitleModel Model { get; set; }
    [Parameter] public EventCallback NextStep { get; set; }
    [Parameter] public Func<string, string> GetInputClass { get; set; }
}
