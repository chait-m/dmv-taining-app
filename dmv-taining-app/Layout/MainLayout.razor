@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #4f8cff 0%, #235390 100%); min-height: 64px; border-radius: 0 0 16px 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <span class="fw-bold" style="font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif; font-size: 2rem; letter-spacing: 1px; color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,0.10);">Welcome to the DMV App!</span>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" style="color: #fff; font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, 'Liberation Sans', sans-serif; font-weight: 500; text-decoration: underline dotted;">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
